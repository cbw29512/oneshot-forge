{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneshotforge.example/schema/zero-to-hero.schema.json",
  "title": "One-Shot Forge From Zero to Hero",
  "type": "object",
  "required": [
    "id",
    "title",
    "rules",
    "start",
    "development",
    "village",
    "chapters",
    "graduation"
  ],
  "properties": {
    "id": {
      "const": "from-zero-to-hero"
    },
    "title": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "required": [
        "mode",
        "criticalChecksHouseRule",
        "editionIsolation",
        "naturalExtremesNeverOverrideTotal"
      ],
      "properties": {
        "mode": {
          "const": "level-0-house-rule"
        },
        "criticalChecksHouseRule": {
          "const": true
        },
        "editionIsolation": {
          "const": true
        },
        "naturalExtremesNeverOverrideTotal": {
          "const": true
        }
      }
    },
    "start": {
      "type": "object",
      "required": [
        "age",
        "scores",
        "className"
      ],
      "properties": {
        "age": {
          "const": 12
        },
        "className": {
          "const": "Level 0"
        },
        "scores": {
          "type": "object",
          "required": [
            "STR",
            "DEX",
            "CON",
            "INT",
            "WIS",
            "CHA"
          ],
          "additionalProperties": false,
          "properties": {
            "STR": {
              "const": 9
            },
            "DEX": {
              "const": 9
            },
            "CON": {
              "const": 9
            },
            "INT": {
              "const": 9
            },
            "WIS": {
              "const": 9
            },
            "CHA": {
              "const": 9
            }
          }
        }
      }
    },
    "development": {
      "type": "object",
      "required": [
        "startingPointBuyCost",
        "baseOpportunities",
        "normalTargetValue",
        "maxPreOriginScore",
        "costToRaise",
        "wallet",
        "pointsByOutcome",
        "lessonRule",
        "criticalFailureRule",
        "criticalSuccessBonusRule",
        "minimumGraduationValue",
        "baseGrowthNeverLost",
        "maturitySettlementRule"
      ],
      "properties": {
        "startingPointBuyCost": {
          "const": 6
        },
        "baseOpportunities": {
          "const": 21
        },
        "normalTargetValue": {
          "const": 27
        },
        "maxPreOriginScore": {
          "const": 15
        },
        "wallet": {
          "const": true
        },
        "pointsByOutcome": {
          "type": "object",
          "required": [
            "criticalSuccess",
            "success",
            "failure",
            "criticalFailure"
          ],
          "properties": {
            "criticalSuccess": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 2
                },
                "lesson": {
                  "const": 0
                },
                "shiftInvested": {
                  "const": 0
                }
              }
            },
            "success": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 1
                },
                "lesson": {
                  "const": 0
                },
                "shiftInvested": {
                  "const": 0
                }
              }
            },
            "failure": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 0
                },
                "lesson": {
                  "const": 1
                },
                "shiftInvested": {
                  "const": 0
                }
              }
            },
            "criticalFailure": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 0
                },
                "lesson": {
                  "const": 1
                },
                "shiftInvested": {
                  "const": 1
                }
              }
            }
          }
        },
        "minimumGraduationValue": {
          "const": 27
        },
        "baseGrowthNeverLost": {
          "const": true
        },
        "maturitySettlementRule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "village": {
      "type": "object"
    },
    "chapters": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "graduation": {
      "type": "object",
      "required": [
        "2014",
        "2024",
        "rawAudit"
      ]
    }
  }
}
