{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneshotforge.example/schema/zero-to-hero.schema.json",
  "title": "One-Shot Forge From Zero to Hero",
  "type": "object",
  "required": [
    "id",
    "title",
    "rules",
    "start",
    "development",
    "village",
    "chapters",
    "graduation",
    "lifeFirstDesign",
    "continuity",
    "graduationKeepsakes"
  ],
  "properties": {
    "id": {
      "const": "from-zero-to-hero"
    },
    "title": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "required": [
        "mode",
        "criticalChecksHouseRule",
        "editionIsolation",
        "naturalExtremesNeverOverrideTotal"
      ],
      "properties": {
        "mode": {
          "const": "level-0-house-rule"
        },
        "criticalChecksHouseRule": {
          "const": true
        },
        "editionIsolation": {
          "const": true
        },
        "naturalExtremesNeverOverrideTotal": {
          "const": true
        }
      }
    },
    "start": {
      "type": "object",
      "required": [
        "age",
        "scores",
        "className"
      ],
      "properties": {
        "age": {
          "const": 12
        },
        "className": {
          "const": "Level 0"
        },
        "scores": {
          "type": "object",
          "required": [
            "STR",
            "DEX",
            "CON",
            "INT",
            "WIS",
            "CHA"
          ],
          "additionalProperties": false,
          "properties": {
            "STR": {
              "const": 9
            },
            "DEX": {
              "const": 9
            },
            "CON": {
              "const": 9
            },
            "INT": {
              "const": 9
            },
            "WIS": {
              "const": 9
            },
            "CHA": {
              "const": 9
            }
          }
        }
      }
    },
    "development": {
      "type": "object",
      "required": [
        "startingPointBuyCost",
        "baseOpportunities",
        "normalTargetValue",
        "maxPreOriginScore",
        "costToRaise",
        "wallet",
        "pointsByOutcome",
        "lessonRule",
        "criticalFailureRule",
        "criticalSuccessBonusRule",
        "minimumGraduationValue",
        "baseGrowthNeverLost",
        "maturitySettlementRule",
        "challengeProfile",
        "maximumGraduationValue",
        "statGrowthCapRule"
      ],
      "properties": {
        "startingPointBuyCost": {
          "const": 6
        },
        "baseOpportunities": {
          "const": 21
        },
        "normalTargetValue": {
          "const": 27
        },
        "maxPreOriginScore": {
          "const": 15
        },
        "wallet": {
          "const": true
        },
        "pointsByOutcome": {
          "type": "object",
          "required": [
            "criticalSuccess",
            "success",
            "failure",
            "criticalFailure"
          ],
          "properties": {
            "criticalSuccess": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 2
                },
                "lesson": {
                  "const": 0
                },
                "shiftInvested": {
                  "const": 0
                }
              }
            },
            "success": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 1
                },
                "lesson": {
                  "const": 0
                },
                "shiftInvested": {
                  "const": 0
                }
              }
            },
            "failure": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 0
                },
                "lesson": {
                  "const": 1
                },
                "shiftInvested": {
                  "const": 0
                }
              }
            },
            "criticalFailure": {
              "type": "object",
              "required": [
                "flexible",
                "lesson",
                "shiftInvested"
              ],
              "properties": {
                "flexible": {
                  "const": 0
                },
                "lesson": {
                  "const": 1
                },
                "shiftInvested": {
                  "const": 1
                }
              }
            }
          }
        },
        "minimumGraduationValue": {
          "const": 27
        },
        "baseGrowthNeverLost": {
          "const": true
        },
        "maturitySettlementRule": {
          "type": "string",
          "minLength": 20
        },
        "challengeProfile": {
          "type": "object",
          "required": [
            "dcByAgeBand",
            "roleplayAdvantage",
            "advantageStacks",
            "criteria",
            "restriction",
            "noRoleplayDisadvantage",
            "resolution"
          ],
          "properties": {
            "dcByAgeBand": {
              "type": "object",
              "required": [
                "12-13",
                "14-16",
                "17-18"
              ],
              "properties": {
                "12-13": {
                  "const": 15
                },
                "14-16": {
                  "const": 16
                },
                "17-18": {
                  "const": 17
                }
              }
            },
            "roleplayAdvantage": {
              "const": true
            },
            "advantageStacks": {
              "const": false
            },
            "criteria": {
              "type": "array",
              "minItems": 3
            },
            "restriction": {
              "type": "string",
              "minLength": 20
            },
            "noRoleplayDisadvantage": {
              "const": true
            },
            "resolution": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "maximumGraduationValue": {
          "const": 30
        },
        "statGrowthCapRule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "village": {
      "type": "object"
    },
    "chapters": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "age",
          "title",
          "lifeEvent",
          "tone",
          "groupActivity",
          "objective",
          "pressure",
          "relationshipFocus",
          "growthBeats",
          "choice",
          "consequence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "minimum": 12,
            "maximum": 18
          },
          "title": {
            "type": "string"
          },
          "lifeEvent": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "groupActivity": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "pressure": {
            "type": "string"
          },
          "relationshipFocus": {
            "type": "array",
            "minItems": 1
          },
          "growthBeats": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3
          },
          "choice": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          }
        }
      }
    },
    "graduation": {
      "type": "object",
      "required": [
        "2014",
        "2024",
        "rawAudit"
      ]
    },
    "lifeFirstDesign": {
      "type": "object",
      "required": [
        "principle",
        "ordinaryLifeYears",
        "escalation",
        "groupRule"
      ],
      "properties": {
        "principle": {
          "type": "string",
          "minLength": 20
        },
        "ordinaryLifeYears": {
          "const": [
            12,
            13,
            14,
            15
          ]
        },
        "escalation": {
          "type": "string",
          "minLength": 30
        },
        "groupRule": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "growthBeatParticipation",
        "yearbook",
        "betweenYears",
        "villageTimeline"
      ],
      "properties": {
        "growthBeatParticipation": {
          "type": "object",
          "required": [
            "rule",
            "noEarlyClose",
            "rotateSpotlight",
            "supportAllowed",
            "supportRule",
            "reframingRule"
          ],
          "properties": {
            "noEarlyClose": {
              "const": true
            },
            "rotateSpotlight": {
              "const": true
            },
            "supportAllowed": {
              "const": true
            }
          }
        },
        "yearbook": {
          "type": "object",
          "required": [
            "requiredAfterEachChapter",
            "grantsDevelopment",
            "prompts",
            "advantageLink"
          ],
          "properties": {
            "requiredAfterEachChapter": {
              "const": true
            },
            "grantsDevelopment": {
              "const": false
            },
            "prompts": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        "betweenYears": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6
        },
        "villageTimeline": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7
        }
      }
    },
    "graduationKeepsakes": {
      "type": "object",
      "required": [
        "enabled",
        "mechanicalBenefit",
        "certificateTitle",
        "certificateSubtitle",
        "certificateStatement",
        "chronicleTitle",
        "pages",
        "signatureLines",
        "requiredCertificateFields",
        "chronicleSections",
        "ruleBoundary"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "mechanicalBenefit": {
          "const": false
        },
        "certificateTitle": {
          "type": "string",
          "minLength": 5
        },
        "certificateSubtitle": {
          "type": "string",
          "minLength": 10
        },
        "certificateStatement": {
          "type": "string",
          "minLength": 20
        },
        "chronicleTitle": {
          "type": "string",
          "minLength": 5
        },
        "pages": {
          "const": 2
        },
        "signatureLines": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "requiredCertificateFields": {
          "type": "array",
          "minItems": 7
        },
        "chronicleSections": {
          "type": "array",
          "minItems": 8
        },
        "ruleBoundary": {
          "type": "string",
          "minLength": 40
        }
      }
    }
  }
}
