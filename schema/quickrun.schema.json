{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneshot-forge.local/schema/quickrun.schema.json",
  "title": "One-Shot Forge Zero-Prep Quick Run",
  "type": "object",
  "required": ["adventureId", "version", "target", "checks", "encounters", "hazards", "rewards", "mapNotes"],
  "properties": {
    "adventureId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "target": {
      "type": "object",
      "required": ["level", "partySize"],
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 20},
        "partySize": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "encounters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/encounter"}},
    "hazards": {"type": "array", "items": {"$ref": "#/$defs/hazard"}},
    "rewards": {"type": "array", "items": {"$ref": "#/$defs/reward"}},
    "mapNotes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapNote"}}
  },
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "sceneId", "label", "dc", "ability", "success", "failure"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "sceneId": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}, "dc": {"type": "integer", "minimum": 1},
        "ability": {"type": "string", "minLength": 1}, "success": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "creature": {
      "type": "object",
      "required": ["name", "count", "ac", "hp", "speed", "tactics"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 1},
        "ac": {"type": "integer", "minimum": 1}, "hp": {"type": "integer", "minimum": 1},
        "speed": {"type": "string", "minLength": 1}, "saves": {"type": "string"},
        "resistances": {"type": "string"}, "immunities": {"type": "string"},
        "attack": {"type": "string"}, "ranged": {"type": "string"}, "action": {"type": "string"},
        "reaction": {"type": "string"}, "trait": {"type": "string"}, "tactics": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "encounter": {
      "type": "object",
      "required": ["id", "objective", "start", "creatures", "end"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1}, "creatures": {"type": "array", "items": {"$ref": "#/$defs/creature"}},
        "bypass": {"type": "string"}, "ritual": {"type": "string"}, "destroy": {"type": "string"},
        "bargain": {"type": "string"}, "end": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "hazard": {
      "type": "object",
      "required": ["id", "sceneId", "trigger", "save", "failure", "success", "failForward"],
      "properties": {
        "id": {"type": "string"}, "sceneId": {"type": "string"}, "trigger": {"type": "string"},
        "save": {"type": "string"}, "failure": {"type": "string"}, "success": {"type": "string"},
        "failForward": {"type": "string"}
      }, "additionalProperties": false
    },
    "reward": {
      "type": "object", "required": ["id", "when", "reward"],
      "properties": {"id": {"type": "string"}, "when": {"type": "string"}, "reward": {"type": "string"}},
      "additionalProperties": false
    },
    "mapNote": {
      "type": "object", "required": ["sceneId", "dimensions", "features"],
      "properties": {
        "sceneId": {"type": "string"}, "dimensions": {"type": "string"},
        "features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }, "additionalProperties": false
    }
  }
}
