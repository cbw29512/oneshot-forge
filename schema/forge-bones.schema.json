{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneshot-forge.local/schema/forge-bones.schema.json",
  "title": "One-Shot Forge Bones",
  "type": "object",
  "required": ["version","seed","theme","preview","hook","questGiver","twist","obstacle","travel","locationProgression","finale","aftermath","randomEncounters"],
  "properties": {
    "version": {"const":"0.1.0"},
    "seed": {"type":"string","minLength":1},
    "theme": {"type":"object","required":["id","spine","motifs"],"properties":{"id":{"type":"string","minLength":1},"spine":{"type":"string","minLength":1},"motifs":{"type":"array","minItems":2,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
    "preview": {"type":"object","required":["origin","destination"],"properties":{"origin":{"type":"string"},"destination":{"type":"string"}},"additionalProperties":false},
    "hook": {"type":"object","required":["type","objective","target"],"properties":{"type":{"type":"string"},"objective":{"type":"string"},"target":{"type":"string"}},"additionalProperties":true},
    "questGiver": {"type":"object","required":["role","motive"],"properties":{"role":{"type":"string"},"motive":{"type":"string"}},"additionalProperties":true},
    "twist": {"type":"object","required":["apparentTruth","actualTruth"],"properties":{"apparentTruth":{"type":"string"},"actualTruth":{"type":"string"}},"additionalProperties":true},
    "obstacle": {"type":"object","required":["kind","mechanic","failForward"],"properties":{"kind":{"enum":["trap","puzzle","trap+puzzle"]},"mechanic":{"type":"string"},"dc":{"type":["integer","null"]},"failForward":{"type":"string"}},"additionalProperties":true},
    "travel": {"type":"object","required":["environment","pressure"],"properties":{"environment":{"type":"string"},"pressure":{"type":"string"}},"additionalProperties":true},
    "locationProgression": {"type":"array","minItems":2,"items":{"type":"object","required":["role","job"],"properties":{"role":{"type":"string"},"job":{"type":"string"}},"additionalProperties":true}},
    "finale": {"type":"object","required":["kind","subject","objective","noncombatResolution","failure"],"properties":{"kind":{"enum":["monster","npc","artifact","ritual","environment","mixed"]},"subject":{"type":"string"},"objective":{"type":"string"},"noncombatResolution":{"type":"string"},"failure":{"type":"string"}},"additionalProperties":true},
    "aftermath": {"type":"object","required":["mode","consequence"],"properties":{"mode":{"enum":["return","continue","choice"]},"consequence":{"type":"string"}},"additionalProperties":true},
    "randomEncounters": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["kind","prompt","questRelated"],"properties":{"kind":{"enum":["combat","social","hazard","discovery","merchant","wildlife","weird","treasure","moral","comic"]},"prompt":{"type":"string"},"questRelated":{"type":"boolean"}},"additionalProperties":true}
  },
  "additionalProperties": false
}
